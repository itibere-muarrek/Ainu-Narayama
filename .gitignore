.coverage

# Ambiente (senhas, etc)
.env
.env.local

# Variáveis do Streamlit
.streamlit/secrets.toml

# Diretório do AINU.systems: saída gerada da planilha do Paper 3. Só a pasta publicavel/ (já passou pelo filtro de auditoria) vai para o git, liberada pelo autor em 2026-11-02;
# privado/ (auditoria interna, resultados completos) e preview/ (HTML estático) ficam de fora.
data/diretorio/*
!data/diretorio/publicavel/

# Material restrito ao administrador (nunca vai para o repositorio publico)
docs/privado/
